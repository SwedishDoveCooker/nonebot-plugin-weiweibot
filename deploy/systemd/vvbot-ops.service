[Unit]
Description=VV bot, operations only (the QQ connection is held by AstrBot)
After=network-online.target time-sync.target
Conflicts=vvbot.service vvbot-search.service
Wants=network-online.target
RequiresMountsFor=/mnt/ssd
StartLimitIntervalSec=0

[Service]
Type=notify
NotifyAccess=main
User=vvbot
Group=vvbot
EnvironmentFile=/mnt/ssd/vvbot/.env
Environment=VV_MODE=ops
Environment=VV_API_ADDR=127.0.0.1:8770
Environment=VV_DATA_DIR=/mnt/ssd/vvbot/data
Environment=VV_LOG_FILE=/mnt/ssd/vvbot/logs/vvbot.log
ExecStart=/mnt/ssd/vvbot/bin/vvbot
Restart=always
RestartSec=5
WatchdogSec=0
TimeoutStartSec=120
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
ReadWritePaths=/mnt/ssd/vvbot/data /mnt/ssd/vvbot/logs
[Install]
WantedBy=multi-user.target
